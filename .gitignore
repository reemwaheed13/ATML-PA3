*.bin
*.safetensors
checkpoints/
features/
generations/
hf_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Notebook / editor cruft
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
